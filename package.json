{
  "name": "nurselinks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:env": "node scripts/check-env.mjs",
    "clone:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clone-prod-to-dev.ps1",
    "storage:dev": "node scripts/copy-storage-prod-to-dev.mjs",
    "recovery:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/backup-all.ps1",
    "recovery:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/restore-all.ps1",
    "recovery:snapshot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/restore-snapshot.ps1",
    "recovery:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/verify-archive.ps1",
    "storage:empty": "node scripts/recovery/empty-storage.mjs",
    "storage:empty:dry": "node scripts/recovery/empty-storage.mjs --dry-run",
    "admin:clear-profile": "node scripts/recovery/clear-admin-profile.mjs",
    "admin:clear-profile:dry": "node scripts/recovery/clear-admin-profile.mjs --dry-run",
    "sql:list": "node scripts/list-supabase-sql.mjs",
    "sql:bundle": "node scripts/build-combined-sql.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
