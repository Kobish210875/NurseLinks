# =============================================================================
# Copy to .env.local for localhost:  copy .env.example .env.local
# Production: set the same names in Vercel → Environment Variables (Production).
# =============================================================================

# --- App mode ---
# .env.local: development | Vercel Production: production
NEXT_PUBLIC_APP_ENV=development
# .env.local: http://localhost:3000 | Vercel Production: https://nurselinks.net
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase DEV project (Dashboard → nurselinks-dev → Settings → API) ---
# Do NOT use production ref ljfycjqawngzzrahyxsl here — npm run check:env will fail.
# To clone production data into dev: copy env.clone.example → env.clone.local, then npm run clone:dev
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Production Vercel only — optional, so /admin/backups can list and download DEV backups too
# SUPABASE_DEV_URL=https://your-dev-project-ref.supabase.co
# SUPABASE_DEV_SERVICE_ROLE_KEY=your-dev-service-role-key

# --- Auth ---
# false on localhost for quick testing; true on Vercel Production
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Email (optional locally) ---
RESEND_API_KEY=
# Display name is added automatically if you omit "Name <addr>":
NOTIFICATIONS_FROM_EMAIL=onboarding@resend.dev

# --- Cron (Vercel Production / Preview only) ---
CRON_SECRET=

# --- Backup & Recovery ---
# GitHub Personal Access Token with repo + workflow scopes.
# Required on Vercel to trigger backup/restore GitHub Actions from the admin UI.
# Create at: GitHub → Settings → Developer settings → Personal access tokens (classic)
# Scopes needed: repo, workflow
GITHUB_PAT=
