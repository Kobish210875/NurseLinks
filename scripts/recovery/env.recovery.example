# Copy to env.recovery.local (gitignored) for scripts/recovery/*.ps1
# Never commit env.recovery.local — it contains database passwords.

# Target Supabase project to back up / restore into
PROJECT_REF=ljfycjqawngzzrahyxsl
SUPABASE_URL=https://ljfycjqawngzzrahyxsl.supabase.co
DB_PASSWORD=your-postgres-password
SERVICE_ROLE_KEY=your-service-role-key

# Session pooler host (IPv4-compatible, same as GitHub Actions uses).
# Find it: Supabase Dashboard -> your project -> Connect -> Session pooler
# Example: aws-0-eu-central-1.pooler.supabase.com
DB_POOLER_HOST=your-pooler-host.pooler.supabase.com

# Optional label in archive folder name (prod | dev)
ENVIRONMENT=prod
